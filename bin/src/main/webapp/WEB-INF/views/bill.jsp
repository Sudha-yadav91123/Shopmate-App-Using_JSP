<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Final Bill</title><link rel="stylesheet" type="text/css" href="/css/style.css"><style>@media print{body{background:white!important}.bill-page{background:white!important}.print-btn,.email-btn,.index-btn,.action-btn,header,footer{display:none!important}.bill-page table{display:table!important;width:100%!important;border-collapse:collapse!important}.bill-page thead{display:table-header-group!important}.bill-page tbody{display:table-row-group!important}.bill-page tr{display:table-row!important}.bill-page td,.bill-page th{display:table-cell!important;border:1px solid #000!important;padding:10px!important;text-align:center!important;color:#000!important}.total-section{font-size:20px!important;font-weight:bold!important;text-align:right!important}}</style></head>
<body><%@ include file="header.jsp" %><div class="container bill-page"><h2 style="text-align:center;">🧾 Final Bill</h2>
<table class="cart-table"><thead><tr><th>Product Name</th><th>Category</th><th>Price</th><th>Quantity</th><th>Subtotal</th></tr></thead><tbody>
<c:forEach var="item" items="${cartItems}"><tr><td>${item.product.pname}</td><td><c:choose><c:when test="${item.product.category != null}">${item.product.category.name}</c:when><c:otherwise>${item.product.legacyCategory}</c:otherwise></c:choose></td><td>₹ ${item.product.price}</td><td>${item.quantity}</td><td>₹ ${item.product.price * item.quantity}</td></tr></c:forEach>
</tbody></table><div class="total-section">Total Bill: ₹ ${totalBill}</div><div style="text-align:center;margin-top:20px"><form action="${pageContext.request.contextPath}/confirm-order" method="post"><button type="submit" class="index-btn">✅ Confirm Order</button></form></div></div><%@ include file="footer.jsp" %></body></html>
